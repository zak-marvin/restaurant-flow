# Copy this to .env and fill in your values

DEBUG=True
SECRET_KEY=change-this-to-a-long-random-string

# Database (PostgreSQL for production)
DB_NAME=restaurantflow
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Firebase FCM (optional — push notifications to staff devices)
# Download service account JSON from Firebase Console → Project Settings → Service Accounts
FCM_CREDENTIALS_PATH=/path/to/firebase-service-account.json

# Mobile money — which provider checkout/views.py actually calls.
# Yo! Payments is the default since it's the one with working access.
#   yo_payments  -> aggregator, network-agnostic, no setup hassle
#   flutterwave  -> aggregator, built+tested, currently waitlisted
#   direct       -> straight to MTN/Airtel, no aggregator, no middleman fee,
#                   but each network is its own separate integration
MOBILE_MONEY_PROVIDER=yo_payments

# Yo! Payments (mobile money) — get these from your dashboard's
# "API Access" page (a separate API username/password from your login).
# Sandbox works immediately with no approval wait.
YO_PAYMENTS_API_USERNAME=
YO_PAYMENTS_API_PASSWORD=
YO_PAYMENTS_USE_PRODUCTION=False

# MTN MoMo (mobile money — direct, no aggregator)
# Subscription key is from momodeveloper.mtn.com -> your Collection product's Primary Key.
# API_USER and API_KEY come from running: python manage.py provision_mtn_momo (one-time only)
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_ENV=sandbox
# Sandbox ONLY accepts EUR as the currency — switch to UGX (confirm exact
# code with MTN support) once you're approved for Go-Live / production.
MTN_MOMO_CURRENCY=EUR
MTN_MOMO_CALLBACK_HOST=
# MTN reveals this during the Go-Live approval process — leave blank until then.
MTN_MOMO_PRODUCTION_BASE_URL=

# Flutterwave (mobile money) — alternate provider, built and tested but
# currently waitlisted pending their approval. Switch MOBILE_MONEY_PROVIDER
# above to 'flutterwave' if/when you get test keys.
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional — only needed if you set up a webhook in the Flutterwave dashboard
FLUTTERWAVE_WEBHOOK_HASH=

# CORS — comma-separated list of allowed Flutter/web origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
